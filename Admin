local function isAdmin(plr)
    return plr and plr.Name == ADMIN_USERNAME
end

local function spawnStatusPopup(targetPlr, msg, col)
    local char = targetPlr and targetPlr.Character
    local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
    if not head then return end

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 170, 0, 36)
    bb.StudsOffset = Vector3.new(0, 3.1, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 15
    lbl.TextColor3 = col or Color3.fromRGB(120, 235, 150)
    lbl.TextStrokeTransparency = 0.25
    lbl.Text = msg
    lbl.Parent = bb

    TweenService:Create(bb, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        StudsOffset = bb.StudsOffset + Vector3.new(0, 1.6, 0),
    }):Play()
    Debris:AddItem(bb, 0.85)
end

local function buildShotgunTool()
    local src = ServerStorage:FindFirstChild(SHOTGUN_NAME)
    if not src then return nil end

    if src:IsA("Tool") then
        local tClone = src:Clone()
        for _, d in ipairs(tClone:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Anchored = false
                d.CanCollide = false
                d.Massless = true
            end
        end
        return tClone
    end

    local tool = Instance.new("Tool")
    tool.Name = SHOTGUN_NAME
    tool.CanBeDropped = false
    tool.RequiresHandle = true
    tool.Grip = CFrame.new(0, -0.15, 0.35) * CFrame.Angles(0, math.rad(180), 0)

    local modelClone = src:Clone()
    local parts = {}
    for _, d in ipairs(modelClone:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = false
            d.CanCollide = false
            d.Massless = true
            table.insert(parts, d)
        elseif d:IsA("Script") or d:IsA("LocalScript") then
            d:Destroy()
        end
    end

    if #parts == 0 then
        tool:Destroy()
        return nil
    end

    local handle = modelClone:FindFirstChild("Handle", true)
    if not (handle and handle:IsA("BasePart")) then
        handle = (modelClone:IsA("Model") and modelClone.PrimaryPart) or parts[1]
        handle.Name = "Handle"
    end

    for _, child in ipairs(modelClone:GetChildren()) do
        child.Parent = tool
    end
    modelClone:Destroy()

    for _, p in ipairs(parts) do
        if p ~= handle then
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = handle
            weld.Part1 = p
            weld.Parent = handle
        end
    end

    return tool
end

local function giveToolToTarget(adminPlr, targetPlr, toolName, statusLabel)
    if not isAdmin(adminPlr) then return end
    if not targetPlr or not targetPlr.Parent then
        if statusLabel then
            statusLabel.TextColor3 = Color3.fromRGB(255, 95, 95)
            statusLabel.Text = "Avval ro'yxatdan username tanlang!"
        end
        return
    end

    local valid = false
    for _, n in ipairs(TOOLS_LIST) do
        if n == toolName then
            valid = true
            break
        end
    end
    if not valid then return end

    local char = targetPlr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local bp = targetPlr:FindFirstChildOfClass("Backpack")
    if not char or not hum or hum.Health <= 0 or not bp then
        if statusLabel then
            statusLabel.TextColor3 = Color3.fromRGB(255, 140, 80)
            statusLabel.Text = targetPlr.Name .. " tirik emas!"
        end
        return
    end

    if toolName == SHOTGUN_NAME then
        local existing = bp:FindFirstChild(SHOTGUN_NAME) or char:FindFirstChild(SHOTGUN_NAME)
        if existing then existing:Destroy() end

        local shotgunTool = buildShotgunTool()
        if shotgunTool then
            shotgunTool.Parent = bp
            hum:EquipTool(shotgunTool)
            spawnStatusPopup(targetPlr, "+ " .. SHOTGUN_NAME, Color3.fromRGB(120, 235, 150))
            if statusLabel then
                statusLabel.TextColor3 = Color3.fromRGB(120, 235, 150)
                statusLabel.Text = targetPlr.Name .. " ga " .. SHOTGUN_NAME .. " berildi!"
            end
        elseif statusLabel then
            statusLabel.TextColor3 = Color3.fromRGB(255, 95, 95)
            statusLabel.Text = "ServerStorage da BAIKAL MP-153 topilmadi!"
        end
        return
    end

    local storageTool = ServerStorage:FindFirstChild(toolName)
    if storageTool and storageTool:IsA("Tool") then
        local existing = bp:FindFirstChild(toolName) or char:FindFirstChild(toolName)
        if existing then existing:Destroy() end

        local clone = storageTool:Clone()
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Anchored = false
                d.CanCollide = false
                d.Massless = true
                d.LocalTransparencyModifier = (toolName == "ClassicTimebomb") and 1 or 0
            end
        end
        clone.Parent = bp
        hum:EquipTool(clone)
    else
        if toolName == "CZ-75" then
            combatRemote:FireClient(targetPlr, "GiveRetroPistol")
        elseif toolName == "Shield" then
            combatRemote:FireClient(targetPlr, "GiveShield")
        elseif toolName == "ClassicTimebomb" then
            combatRemote:FireClient(targetPlr, "GiveTimeBomb")
        else
            local fallbackTool = Instance.new("Tool")
            fallbackTool.Name = toolName
            fallbackTool.RequiresHandle = true
            fallbackTool.CanBeDropped = false
            local handle = Instance.new("Part")
            handle.Name = "Handle"
            handle.Size = Vector3.new(0.25, 0.25, 1.1)
            handle.Color = Color3.fromRGB(180, 185, 195)
            handle.Material = Enum.Material.Metal
            handle.Parent = fallbackTool
            fallbackTool.Parent = bp
            hum:EquipTool(fallbackTool)
        end
    end

    spawnStatusPopup(targetPlr, "+ " .. toolName, Color3.fromRGB(120, 235, 150))
    if statusLabel then
        statusLabel.TextColor3 = Color3.fromRGB(120, 235, 150)
        statusLabel.Text = targetPlr.Name .. " ga " .. toolName .. " berildi!"
    end
end

